# Virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Test, type-checking, and linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
pytest.xml
.pyre/
.pytype/

# Packaging and build artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Logs and temporary files
*.log
*.tmp
*.temp
*.swp
*.swo

# Environment and local configuration
.env
.env.*
!.env.example

# IDE and editor files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.iml

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# Local tooling files
.pyright/

# Optional model response debugging
challenge_*_response.json

# Workspace-local dependency cache
.uv-cache/
