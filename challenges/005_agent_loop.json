{
  "id": "005_agent_loop",
  "name": "Three-Step Arithmetic: Agent Loop and Stopping",
  "description": "Learn to run a bounded model-tool loop, pass each actual tool result back to the model, and stop when the model returns no function call.",
  "learning_objectives": [
    "Replace fixed first/second response code with a loop.",
    "Maintain previous_response_id across model turns.",
    "Link each function_call_output to its function call using call_id.",
    "Stop on a final non-tool response.",
    "Prevent runaway execution with a maximum model-turn limit."
  ],
  "messages": [
    {
      "role": "user",
      "content": "Start with 100. First add 20. Wait for that tool result, then multiply the returned value by 3. Wait for that tool result, then subtract 10. Use exactly one tool per step, never calculate an operation yourself, and after the final tool result respond without calling another tool."
    }
  ],
  "tools": [
    {
      "name": "add_numbers",
      "description": "Add two numbers.",
      "parameters": {
        "type": "object",
        "properties": {
          "left": {
            "type": "number",
            "description": "Left operand."
          },
          "right": {
            "type": "number",
            "description": "Right operand."
          }
        },
        "required": [
          "left",
          "right"
        ]
      }
    },
    {
      "name": "multiply_numbers",
      "description": "Multiply two numbers.",
      "parameters": {
        "type": "object",
        "properties": {
          "left": {
            "type": "number",
            "description": "Left operand."
          },
          "right": {
            "type": "number",
            "description": "Right operand."
          }
        },
        "required": [
          "left",
          "right"
        ]
      }
    },
    {
      "name": "subtract_numbers",
      "description": "Subtract the right number from the left number.",
      "parameters": {
        "type": "object",
        "properties": {
          "left": {
            "type": "number",
            "description": "Left operand."
          },
          "right": {
            "type": "number",
            "description": "Right operand."
          }
        },
        "required": [
          "left",
          "right"
        ]
      }
    }
  ],
  "expected": {
    "steps": [
      {
        "tool": "add_numbers",
        "arguments": {
          "left": 100,
          "right": 20
        },
        "result": 120
      },
      {
        "tool": "multiply_numbers",
        "arguments": {
          "left": 120,
          "right": 3
        },
        "result": 360
      },
      {
        "tool": "subtract_numbers",
        "arguments": {
          "left": 360,
          "right": 10
        },
        "result": 350
      }
    ],
    "result": 350,
    "call_count": 3,
    "model_turn_count": 4
  }
}
